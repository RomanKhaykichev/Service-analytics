# Database Configuration (для локальной разработки часто postgres/postgres)
# Скопируйте в .env и замените пароль при необходимости
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/service_analytics
DB_SCHEMA=app

# App Environment
APP_ENV=dev

# Dev fallback user_id (only used when APP_ENV=dev and X-User-Id header is missing)
DEFAULT_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# JWT Configuration
JWT_SECRET=change-me-in-production-secret-key-min-32-chars
JWT_ISSUER=service-analytics-api
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Logging
LOG_LEVEL=INFO

# Admin panel: comma-separated emails or UUIDs allowed to access /api/admin/*
ADMIN_USER_IDS=mr.romanx@mail.ru,asparrow48@gmail.com
