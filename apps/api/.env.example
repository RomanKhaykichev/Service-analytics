# Скопируйте в apps/api/.env и заполните своими значениями. Этот файл коммитится в git — без секретов.

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/service_analytics
DB_SCHEMA=app

# App Environment
APP_ENV=dev
# Optional: строже как в prod
# ENV=prod

# Uvicorn за nginx (доверие к X-Forwarded-Proto)
# UVICORN_PROXY_HEADERS=1
# FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# Dev: fallback user_id, если нет заголовка (только APP_ENV=dev)
DEFAULT_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# JWT — в проде задайте длинный случайный секрет
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ISSUER=service-analytics-api
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
PENDING_TTL_HOURS=24

# CORS: через запятую; пусто = дефолтный список в коде
# CORS_ORIGINS=https://app.profiboard.uz,https://profiboard.uz

# Prod: cookie refresh (Secure, SameSite, Domain)
# COOKIE_DOMAIN=.profiboard.uz

LOG_LEVEL=INFO

# Админка /api/admin/* — email или UUID через запятую
ADMIN_USER_IDS=admin@example.com

# SMS Eskiz (https://notify.eskiz.uz/api). Без ESKIZ_EMAIL/PASSWORD/FROM — в dev SMS в лог (ConsoleSmsProvider).
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Альфа-имя (ник отправителя) из кабинета Eskiz, напр. 4546
ESKIZ_FROM=
SMS_DEBUG_LOG_CODE=false
# Текст как в утверждённом шаблоне Eskiz; плейсхолдер {code} обязателен в приложении.
# SMS_OTP_TEMPLATE=PROFiboard (profiboard.uz): kod dlya registratsii i podtverzhdeniya nomera: {code}

# OTP: sha256(OTP_SECRET + code) — свой секрет в .env
OTP_SECRET=change-me-otp-secret-min-16-chars
