# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Production API URL (обязательно при сборке для profiboard.uz, если API на отдельном хосте)
# Без этой переменной запросы трекинга (лендинг, «Попробовать бесплатно») и другие API идут на тот же домен (relative).
# Если API на поддомене (например https://api.profiboard.uz), при сборке задайте:
# VITE_API_URL=https://api.profiboard.uz
# VITE_API_URL=https://api.profiboard.uz
