# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_analytics

# PostgreSQL Connection
POSTGRES_DB=service_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database Schema
DB_SCHEMA=app

# App Settings
APP_ENV=dev
LOG_LEVEL=INFO
DEFAULT_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# JWT Settings (change in production!)
JWT_SECRET=change-me-in-production-secret-key-min-32-chars
JWT_ISSUER=service-analytics-api
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Admin panel: comma-separated emails allowed to access /api/admin/*
ADMIN_USER_IDS=admin@example.com
