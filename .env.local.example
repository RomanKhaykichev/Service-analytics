# Local Docker edition. start.bat copies this to .env.local if missing.
# .env.local is gitignored — do not use production secrets from the VPS.

POSTGRES_DB=service_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_SCHEMA=app

APP_ENV=dev
LOG_LEVEL=INFO

JWT_SECRET=local-docker-change-me-secret-key-min-32
OTP_SECRET=local-docker-otp-secret
JWT_ISSUER=service-analytics-api
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

ADMIN_USER_IDS=admin@example.com

# Site URL in the browser (start.bat opens http://localhost:8080)
WEB_BIND=127.0.0.1
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Without ESKIZ_* the SMS code is printed in API logs (ConsoleSmsProvider)
SMS_DEBUG_LOG_CODE=true
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=
